# Configuration Django
# Générer une clé : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=votre_cle_secrete_ici
DEBUG=True
# Cette app peut lancer des commandes shell : ne pas exposer au réseau.
# Garder localhost sauf besoin explicite (et dans ce cas, ajouter une authentification).
ALLOWED_HOSTS=127.0.0.1,localhost
# Disques à surveiller — format : "Nom:/chemin|Nom:/chemin"
MONITOR_DISKS="Système:/|Disque Data:/media/data"

# Port du serveur Django
PORT=8800

# Widget Météo — coordonnées et fuseau horaire Open-Meteo
WEATHER_CITY=Montréal, QC
WEATHER_LAT=45.5017
WEATHER_LON=-73.5673
WEATHER_TIMEZONE=America/Toronto

# Widget Horloges — format : "Label:Timezone/IANA|Label:Timezone/IANA"
CLOCK_TIMEZONES="Paris:Europe/Paris|SF:America/Los_Angeles|Pékin:Asia/Shanghai"